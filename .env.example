# Database
DATABASE_URL="postgresql://app:app@localhost:5432/automation?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# MinIO (S3-compatible)
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_BUCKET="automation-artifacts"
S3_REGION="us-east-1"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# OAuth2/OIDC
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-change-in-production"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""

# Email
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@automation.local"

# Slack
SLACK_CLIENT_ID=""
SLACK_CLIENT_SECRET=""
SLACK_SIGNING_SECRET=""

# Google Workspace
GOOGLE_SERVICE_ACCOUNT_KEY=""
GOOGLE_WORKSPACE_DOMAIN=""

# Microsoft 365
MICROSOFT_TENANT_ID=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""

# Salesforce
SALESFORCE_CLIENT_ID=""
SALESFORCE_CLIENT_SECRET=""
SALESFORCE_SANDBOX="true"

# HubSpot
HUBSPOT_CLIENT_ID=""
HUBSPOT_CLIENT_SECRET=""

# Jira
JIRA_BASE_URL=""
JIRA_CLIENT_ID=""
JIRA_CLIENT_SECRET=""

# Zendesk
ZENDESK_SUBDOMAIN=""
ZENDESK_CLIENT_ID=""
ZENDESK_CLIENT_SECRET=""

# Temporal (optional)
ENABLE_TEMPORAL="false"
TEMPORAL_ADDRESS="localhost:7233"

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=""
PROMETHEUS_ENDPOINT=""

# Feature Flags
ENABLE_LLM_FALLBACK="true"
ENABLE_OCR_CLOUD="false"
ENABLE_SANDBOX_MODE="true"

# Security
ENCRYPTION_KEY="your-encryption-key-32-chars-min"
WEBHOOK_SECRET="your-webhook-secret"

# Rate Limiting
RATE_LIMIT_TTL="60"
RATE_LIMIT_MAX="100"

# Retention
AUDIT_RETENTION_DAYS="2555" # 7 years
RUN_RETENTION_DAYS="90"
ARTIFACT_RETENTION_DAYS="365"